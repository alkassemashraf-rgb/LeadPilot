# Database
DATABASE_URL=sqlite+aiosqlite:///./leadpilot.db

# Redis (optional locally — falls back to safe mode if unavailable)
REDIS_URL=redis://localhost:6379/0

# Security — generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ADMIN_JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
# Generate a REAL key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: The key below is a PUBLIC demo-only key used in CI and the HF demo space.
#          Replace it with a private key before handling real customer data.
ENCRYPTION_KEY_FERNET=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_OUTPUT_TOKENS=2048

# Integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
WHATSAPP_VERIFY_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Override redirect URI explicitly if the auto-derived one is wrong (usually not needed)
GOOGLE_OAUTH_REDIRECT_URI=

# Email
EMAIL_PROVIDER=console
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=LeadPilot
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY=2
# Public-facing frontend URL — used to construct Google OAuth redirect_uri and email links.
# Local dev: http://localhost:3000
# HuggingFace: https://YOUR_USERNAME-YOUR_SPACE_NAME.hf.space
APP_BASE_URL=http://localhost:3000
EMAIL_REPLY_TO=

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=LeadPilot

# Initial SuperAdmin (seeded on first startup if not yet in DB)
FIRST_SUPERADMIN_EMAIL=admin@yourdomain.com
FIRST_SUPERADMIN_PASSWORD=ChangeThisPassword123!
